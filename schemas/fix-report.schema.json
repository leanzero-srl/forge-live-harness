{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fix-report.schema.json",
  "title": "FixReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "scenarioId", "producer", "generatedAt", "verdict", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string" },
    "scenarioId": { "type": "string" },
    "producer": { "enum": ["claude-code", "api-adapter"] },
    "model": { "type": "string" },
    "generatedAt": { "type": "string" },
    "verdict": { "enum": ["pass", "fail", "needs-human"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stepIndex", "severity", "localization", "observed", "expected", "rootCause", "evidence", "suggestedFix", "repro"],
        "properties": {
          "id": { "type": "string" },
          "stepIndex": { "type": "integer" },
          "severity": { "enum": ["blocker", "major", "minor", "cosmetic"] },
          "localization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface"],
            "properties": {
              "surface": { "type": "string", "description": "module + area, e.g. jira:globalPage/ppm-dashboard > Gantt" },
              "selector": { "type": "string" },
              "ariaName": { "type": "string" },
              "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            }
          },
          "observed": { "type": "string" },
          "expected": { "type": "string" },
          "rootCause": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hypothesis", "confidence", "lowConfidence"],
            "properties": {
              "hypothesis": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "lowConfidence": { "type": "boolean", "description": "MUST be true when confidence < 0.5" }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": { "enum": ["screenshot", "console", "network", "aria", "trace"] },
                "ref": { "type": "string", "description": "e.g. steps/03-load.png | console.json#42 | network.json#57" },
                "quote": { "type": "string" }
              }
            }
          },
          "suggestedFix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo", "filePathHint", "change"],
              "properties": {
                "repo": { "type": "string" },
                "filePathHint": { "type": "string" },
                "symbolHint": { "type": "string" },
                "change": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "repro": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
