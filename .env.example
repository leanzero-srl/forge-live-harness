# Copy to .env and fill in. .env is gitignored.

# --- Jira/Confluence REST (basic auth) — used for live test-DATA setup/teardown ---
JIRA_BASE_URL=https://wolfaenpak.atlassian.net
JIRA_ADMIN_EMAIL=mihai@wolfaenpak.com
# Atlassian API token (id.atlassian.com > Security > API tokens). NOT your password.
JIRA_API_TOKEN=

# --- Forge env IDs (OPTIONAL overrides) ---
# Defaults are baked into config/targets.ts (the up-to-date development installs on
# wolfaenpak). Set these only to point at a different environment (prod/staging).
LZ_PPM_ENV_ID=
COGNI_ENV_ID=
SENTINEL_ENV_ID=
CHATWISE_ENV_ID=
# Issue used for the ChatWise jira:issuePanel render smoke (any real wolfaenpak issue).
CHATWISE_PANEL_ISSUE=WFH-1
# Confluence space for the Sentinel Vault space page (any wolfaenpak space: DEMO/JT/WFH).
SENTINEL_SPACE_KEY=WFH

# --- Browser run options ---
# HEADLESS=1 forces headless (may trip Atlassian "new device" 2FA — see README). Default: headed.
# HEADLESS=1

# --- Autonomous assessor adapter (optional; Claude-Code-in-loop needs none of this) ---
ANTHROPIC_API_KEY=
ASSESS_MODEL=claude-opus-4-8
ASSESS_MAX_TOKENS=16000
ASSESS_MAX_KEYFRAMES=6

# --- Headless/CI escalation only (optional): automate TOTP 2FA ---
ATLASSIAN_TOTP_SECRET=
