{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "auth/**/*.ts",
    "config/**/*.ts",
    "forge/**/*.ts",
    "capture/**/*.ts",
    "fixtures/**/*.ts",
    "assess/**/*.ts",
    "scenarios/**/*.ts",
    "playwright.config.ts"
  ]
}
